# =========================================================================
# Firecrawl Self-Hosted Configuration (tekgnosis-net fork)
# =========================================================================
# This is a comprehensive reference of env vars recognized by the Firecrawl
# API server and workers. Copy to .env and customize.
#
# For docker-compose, the database/queue URLs and microservice URLs are
# pre-wired to point at the in-compose containers — you typically only
# need to set BULL_AUTH_KEY and any AI/proxy keys you want.
#
# The authoritative schema is apps/api/src/config.ts (Zod). The official
# self-hosting guide is at docs.firecrawl.dev/contributing/self-host.
# =========================================================================


# ----- Required: HTTP server -----
PORT=3002
HOST=0.0.0.0

# ----- Required: Authentication mode -----
# Self-hosted Firecrawl does NOT support Supabase auth (cloud-only feature).
# Leave this false; API keys are not validated for SDK clients hitting your
# self-hosted endpoint.
USE_DB_AUTHENTICATION=false

# ----- Required: Admin UI key -----
# Grants access to /admin/<key>/queues (the BullMQ admin UI). Set to a strong
# secret on any deployment reachable from untrusted networks.
BULL_AUTH_KEY=CHANGEME


# =========================================================================
# Auto-wired by docker-compose (override only if running outside compose)
# =========================================================================
# REDIS_URL=redis://redis:6379
# REDIS_RATE_LIMIT_URL=redis://redis:6379
# NUQ_DATABASE_URL=postgres://postgres:postgres@nuq-postgres:5432/postgres
# PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape
# CAMOUFOX_MICROSERVICE_URL=http://camoufox-service:3001/scrape  # stealth fallback
# HTML_TO_MARKDOWN_SERVICE_URL=  # leave unset to use the in-process Go FFI
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=postgres

# To disable the camoufox stealth fallback entirely, set the URL to empty:
# CAMOUFOX_MICROSERVICE_URL=


# =========================================================================
# AI / LLM features (/extract, JSON format on /scrape, /agent endpoint)
# =========================================================================
# Pick ONE of the following providers (or set OPENAI-compatible to a local
# Ollama instance). Without any key set, AI-dependent features are disabled.

# OpenAI (recommended for most users):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                # leave unset for api.openai.com; override for Azure/compatible

# Ollama (local LLMs — runs alongside Firecrawl):
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api
# MODEL_NAME=deepseek-r1:7b
# MODEL_EMBEDDING_NAME=nomic-embed-text

# OpenRouter (multi-provider router):
# OPENROUTER_API_KEY=

# xAI (Grok models):
# XAI_API_KEY=

# Google Vertex AI (service account JSON, base64-encoded):
# VERTEX_CREDENTIALS=


# =========================================================================
# Concurrency & performance tuning
# =========================================================================
# Number of BullMQ workers per queue (4-8 typical; raise for higher throughput)
NUM_WORKERS_PER_QUEUE=8
# Concurrent crawl page requests per crawl job (8-16 typical; 32+ for high-tput)
CRAWL_CONCURRENT_REQUESTS=10
# Maximum simultaneous crawl jobs across all teams
MAX_CONCURRENT_JOBS=5
# Browser instance pool size for the playwright service
BROWSER_POOL_SIZE=5
# Worker resource gates: reject new jobs when CPU/RAM exceed these fractions (0..1)
MAX_CPU=0.8
MAX_RAM=0.8

# Per-engine retry / fallback tuning (advanced, defaults usually fine):
# SCRAPE_MAX_ATTEMPTS=6
# SCRAPE_MAX_FEATURE_TOGGLES=3
# SCRAPE_MAX_FEATURE_REMOVALS=3
# SCRAPEURL_ENGINE_WATERFALL_DELAY_MS=0   # 0 = race engines, >0 = sequential waterfall


# =========================================================================
# Proxy (rotates outbound IPs for all browser engines)
# =========================================================================
# PROXY_SERVER can be a full URL (http://host:port) or IP:port. Leave USERNAME
# and PASSWORD empty/unset for unauthenticated proxies.
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Block image/video/audio requests inside the browser to save proxy bandwidth:
# BLOCK_MEDIA=true


# =========================================================================
# Search backend (/search API)
# =========================================================================
# Defaults to scraping Google directly. Override with a SearXNG instance for
# self-hosted search (your SearXNG settings.yml must enable JSON format).
# SEARXNG_ENDPOINT=http://searxng:8080
# SEARXNG_ENGINES=
# SEARXNG_CATEGORIES=


# =========================================================================
# PDF processing (optional)
# =========================================================================
# LlamaParse cloud (recommended for complex/scanned PDFs):
# LLAMAPARSE_API_KEY=

# Fire-PDF (proprietary internal service, set only if you have access):
# FIRE_PDF_ENABLE=true
# FIRE_PDF_BASE_URL=
# FIRE_PDF_API_KEY=

# MinerU direct routing (% of PDF traffic to bypass Rust extraction):
# MINERU_PERCENT=0


# =========================================================================
# Webhooks
# =========================================================================
# Firecrawl POSTs scrape/crawl events to this URL. HMAC secret signs payloads.
# SELF_HOSTED_WEBHOOK_URL=
# SELF_HOSTED_WEBHOOK_HMAC_SECRET=

# Allow webhook URLs that resolve to private IPs/localhost (default: blocks SSRF):
# ALLOW_LOCAL_WEBHOOKS=false

# Slack notifications for server health:
# SLACK_WEBHOOK_URL=


# =========================================================================
# Object storage (optional — for screenshots & job artifacts)
# =========================================================================
# Google Cloud Storage:
# GCS_BUCKET_NAME=
# GCS_CREDENTIALS=                # base64-encoded service-account JSON
# GCS_FIRE_ENGINE_BUCKET_NAME=
# GCS_INDEX_BUCKET_NAME=
# GCS_MEDIA_BUCKET_NAME=


# =========================================================================
# Specialty integrations (optional)
# =========================================================================
# Fire Engine (closed beta — premium scrape backend; set only if you have access):
# FIRE_ENGINE_BETA_URL=

# Wikipedia Enterprise API (premium routing for *.wikipedia.org in /search):
# WIKIPEDIA_ENTERPRISE_USERNAME=
# WIKIPEDIA_ENTERPRISE_PASSWORD=

# LangSmith tracing for the /interact agent:
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
# LANGSMITH_TRACING=true

# Browser session service (for /v2/scrape/:id/interact persistent sessions):
# BROWSER_SERVICE_URL=
# BROWSER_SERVICE_API_KEY=

# Audio scraping (avgrab service):
# AVGRAB_SERVICE_URL=


# =========================================================================
# Logging & observability
# =========================================================================
# Levels: NONE, ERROR, WARN, INFO, DEBUG, TRACE
LOGGING_LEVEL=INFO

# Sentry error tracking:
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACE_SAMPLE_RATE=0.01
# SENTRY_ERROR_SAMPLE_RATE=0.05


# =========================================================================
# Testing (only set when running the snip test suite)
# =========================================================================
# TEST_API_KEY=                   # used if you've set up DB auth and want a real key
# TEST_API_URL=http://127.0.0.1:3002
# TEST_SUITE_SELF_HOSTED=true     # gates tests that require fire-engine / paid APIs
# TEST_SUITE_WEBSITE=http://127.0.0.1:4321
# RATE_LIMIT_TEST_API_KEY_SCRAPE=
# RATE_LIMIT_TEST_API_KEY_CRAWL=


# =========================================================================
# Behavior flags (advanced)
# =========================================================================
# Skip the host blocklist (allows scraping localhost & private IPs — DANGEROUS):
# DISABLE_BLOCKLIST=false

# Comma-separated ISO country codes whose scrapes should be rejected:
# RESTRICTED_COUNTRIES=

# Disable the engine-picker A/B selection logic (forces default fallback list):
# DISABLE_ENGPICKER=true

# Log to file (in addition to stdout):
# FIRECRAWL_LOG_TO_FILE=true


# =========================================================================
# Docker-compose image overrides (fork-specific)
# =========================================================================
# Override the GHCR images each fork-owned service pulls. Useful if you mirror
# images to a private registry or want to pin to a specific tag/digest.
# Defaults pull `:latest` from this fork's GHCR namespace.
# FIRECRAWL_IMAGE=ghcr.io/tekgnosis-net/firecrawl:latest
# PLAYWRIGHT_SERVICE_IMAGE=ghcr.io/tekgnosis-net/playwright-service:latest
# CAMOUFOX_SERVICE_IMAGE=ghcr.io/tekgnosis-net/camoufox-service:latest
# NUQ_POSTGRES_IMAGE=ghcr.io/tekgnosis-net/nuq-postgres:latest


# =========================================================================
# Notes for first-time users
# =========================================================================
# 1. After `docker compose up -d`, the API is at http://localhost:3002.
# 2. Admin/queue UI: http://localhost:3002/admin/<BULL_AUTH_KEY>/queues
# 3. SDK clients can use ANY value for the api key — auth is bypassed when
#    USE_DB_AUTHENTICATION=false. The `x-api-key` header is ignored.
# 4. Test the stack:
#      curl http://localhost:3002/test                    # → "Hello, world!"
#      curl -X POST http://localhost:3002/v2/scrape \
#        -H 'Content-Type: application/json' \
#        -d '{"url":"https://example.com"}'
# 5. To exercise the stealth (Camoufox) fallback path explicitly:
#      curl -X POST http://localhost:3002/v2/scrape \
#        -H 'Content-Type: application/json' \
#        -d '{"url":"https://example.com","proxy":"stealth"}'
# 6. For the complete env-var schema (~150 vars including internal/cloud-only),
#    see apps/api/src/config.ts.
